# Skill audit sidecar backups — stamped rollback files, not source of truth
*.backup-*
.backup-*

# OneDrive sync artifacts
.DS_Store
Thumbs.db
desktop.ini

# Editor cruft
.vscode/
.idea/
*.swp
*~

# Never commit local secrets/tokens if a skill accidentally drops one here
.env
.env.*
*.token
*_credentials.json

__pycache__/
*.pyc

# Generated skill/plugin packages — build artifacts; never tracked
*.skill
*.plugin

# Skill-development scratch tree — machine-local pending state, not history (broadened 2026-07-26; was PENDING_REIMPORT.md only)
_staging/

# Git worktree admin dirs (EnterWorktree / git worktree add convention, 2026-07-12)
.claude/worktrees/

# Eval-harness daily run output (Rev 10 R10-2, 2026-08-14): writes a run JSON +
# a summary.csv row on every daily fire, which made this single-writer checkout
# show uncommitted work every day (false-positive against the shared-checkout
# protocol) and would have committed ~365 JSONs/yr. Machine-local run state,
# not source of truth.
acquisition-underwriting-eval-harness/runs/
# pytest run state (never skill content; package_skills.is_bundled also excludes it)
.pytest_cache/
