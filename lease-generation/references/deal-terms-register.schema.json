{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ORA Lease Deal-Terms Register v1.0",
  "description": "Normalized business terms for one lease. Every field carries a `source` (LOI page/line, email, Notion, or 'ORA default') so the conformance matrix can cite it. Fields marked ORA-default are filled from the ratified standing positions when the LOI is silent.",
  "type": "object",
  "required": ["deal_id", "landlord", "tenant", "premises", "term", "rent", "expense_structure", "security_deposit", "maintenance", "broker", "source_documents"],
  "properties": {
    "deal_id": {"type": "string", "description": "e.g. EXAMPLE-15A-ZEPHYR-2026-01 (property-suite-tenant-yyyy-mm)"},
    "source_documents": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "type": {"enum": ["LOI", "email", "term sheet", "prior lease", "Notion", "verbal"]}, "date": {"type": "string"}}}},
    "template": {"type": "object", "properties": {"property_key": {"type": "string", "description": "Northwood | Easton | Salisbury | Raytown | Columbia | … (rebase output)"}, "state": {"enum": ["OH", "MD", "IN", "MO", "KS", "WI", "TN"]}, "file": {"type": "string"}}},
    "landlord": {"type": "object", "required": ["entity", "state_of_formation", "notice_address"], "properties": {"entity": {"type": "string"}, "entity_type": {"type": "string"}, "state_of_formation": {"type": "string"}, "notice_address": {"type": "string"}, "copy_to": {"type": "string"}, "signatory": {"type": "string"}, "signatory_title": {"type": "string"}}},
    "tenant": {"type": "object", "required": ["entity"], "properties": {
      "entity": {"type": "string"}, "entity_type": {"type": "string"}, "state_of_formation": {"type": "string"},
      "co_tenants": {"type": "array", "items": {"type": "string"}, "description": "Individuals joined jointly and severally (ORA ratified position 2 — never a guaranty)"},
      "notice_address": {"type": ["string", "null"]}, "notice_email": {"type": ["string", "null"]},
      "business_description": {"type": "string"}, "signatory": {"type": "string"}, "signatory_title": {"type": "string"}}},
    "premises": {"type": "object", "required": ["address", "suite", "rsf"], "properties": {
      "project_name": {"type": "string", "description": "Verify against executed leases at the property, not the broker's marketing name"},
      "address": {"type": "string"}, "suite": {"type": "string"}, "rsf": {"type": "integer"},
      "building_rsf": {"type": ["integer", "null"]}, "project_rsf": {"type": "integer"}, "proportionate_share_pct": {"type": "number"},
      "county": {"type": "string"}, "parcel_id": {"type": ["string", "null"]}, "exhibit_a_plan": {"type": "string", "description": "path or 'TO BE ATTACHED'"}}},
    "use": {"type": "object", "properties": {"permitted_use": {"type": "string"}, "restrictions": {"type": "array", "items": {"type": "string"}}}},
    "term": {"type": "object", "required": ["months", "target_commencement"], "properties": {
      "months": {"type": "integer"}, "target_commencement": {"type": "string", "format": "date"},
      "commencement_basis": {"enum": ["fixed", "later_of_target_or_delivery"], "default": "later_of_target_or_delivery"},
      "expiration": {"type": ["string", "null"]}, "outside_date_days": {"type": "integer", "default": 90},
      "early_access": {"type": ["string", "null"]}}},
    "options": {"type": "array", "items": {"type": "object", "properties": {
      "months": {"type": "integer"}, "notice_window_months": {"type": "array", "items": {"type": "integer"}, "default": [12, 6]},
      "rent_basis": {"enum": ["schedule", "flat", "fmr_with_floor"]}, "conditions": {"type": "string", "default": "ORA standard (no default, ≤2 late payments/12 mo, original tenant in full occupancy, no assignment)"}}}},
    "rent": {"type": "object", "required": ["schedule"], "properties": {
      "schedule": {"type": "array", "items": {"type": "object", "required": ["lease_year", "monthly"], "properties": {"lease_year": {"type": "integer"}, "monthly": {"type": "number"}, "annual": {"type": "number"}, "period": {"type": "string"}}}},
      "escalation": {"type": "object", "properties": {"type": {"enum": ["none", "fixed_pct", "fixed_amount", "cpi"]}, "value": {"type": "number"}, "applies_to_option": {"type": "boolean"}}},
      "first_month_on_execution": {"type": "boolean", "default": true},
      "late_charge_pct": {"type": "number", "default": 10}, "default_rate_pct": {"type": "number", "default": 18},
      "payment_method": {"type": "string", "default": "Tenant Portal"}}},
    "expense_structure": {"type": "object", "required": ["type"], "properties": {
      "type": {"enum": ["gross", "modified_gross_base_year", "nnn"]},
      "base_year": {"type": ["integer", "null"], "description": "modified_gross only — calendar year of the Commencement Date (position 1)"},
      "included_in_rent": {"type": "array", "items": {"type": "string"}},
      "tenant_exclusions": {"type": "array", "items": {"type": "string"}, "default": ["personal property taxes", "tenant-caused insurance increases", "separately metered utilities", "tenant-caused repairs", "parking charges"]}}},
    "utilities": {"type": "object", "properties": {
      "electric": {"enum": ["separately_metered_tenant_direct", "landlord_billed_pro_rata", "included"]},
      "gas": {"type": ["string", "null"]},
      "water_sewer": {"enum": ["pro_rata_building_meter", "pro_rata_project", "submetered", "flat_fee", "included"]},
      "water_sewer_flat_fee": {"type": ["number", "null"]}, "trash": {"type": "string"}}},
    "security_deposit": {"type": "object", "properties": {"amount": {"type": "number"}, "months": {"type": "number", "default": 1.0}}},
    "parking": {"type": "object", "properties": {
      "allocation": {"type": "string", "default": "pro rata (Tenant's Allocation)"},
      "overnight_vehicles": {"type": ["integer", "null"]}, "vehicle_class_cap": {"type": "string", "default": "≤10,000 lb GVWR; no trailers/box trucks"},
      "reserved_spaces": {"type": ["integer", "null"]}}},
    "landlord_work": {"type": "object", "properties": {
      "items": {"type": "array", "items": {"type": "string"}},
      "exhibit_b_spec": {"type": ["string", "null"]}, "substantial_completion_standard": {"type": "string", "default": "ORA standard"},
      "punch_list_days": {"type": "integer", "default": 5}, "latent_defect_days": {"type": "integer", "default": 60}}},
    "maintenance": {"type": "object", "required": ["allocation"], "properties": {
      "allocation": {"enum": ["ORA_form_default_tenant_hvac", "LOI_landlord_hvac_and_major_mechanicals", "custom"]},
      "landlord": {"type": "array", "items": {"type": "string"}}, "tenant": {"type": "array", "items": {"type": "string"}},
      "hvac_replacement": {"enum": ["landlord", "tenant", "landlord_amortized"]}, "filters_on_tenant": {"type": "boolean", "default": true}}},
    "insurance": {"type": "object", "properties": {"cgl_occurrence": {"type": "number", "default": 1000000}, "cgl_aggregate": {"type": "number", "default": 2000000}, "umbrella": {"type": "number", "default": 2000000}, "auto_csl": {"type": "number", "default": 1000000}, "employers_liability": {"type": "number", "default": 500000}}},
    "signage": {"type": ["string", "null"]},
    "broker": {"type": "object", "properties": {"firm": {"type": "string"}, "landlord_agent": {"type": "string"}, "tenant_agent": {"type": "string"}, "dual_agency": {"type": "boolean"}, "commission_agreement": {"type": "string", "default": "separate written agreement"}}},
    "special_provisions": {"type": "array", "items": {"type": "object", "properties": {"title": {"type": "string"}, "text": {"type": "string"}, "placement": {"type": "string"}}}},
    "ratified_position_departures": {"type": "array", "items": {"type": "object", "properties": {"position": {"type": "integer"}, "reason": {"type": "string"}, "compelled_by_loi": {"type": "boolean"}}}},
    "decision_gates": {"type": "array", "items": {"type": "object", "properties": {"question": {"type": "string"}, "options": {"type": "array", "items": {"type": "string"}}, "recommendation": {"type": "string"}, "resolved": {"type": ["string", "null"]}}}},
    "open_items": {"type": "array", "items": {"oneOf": [
      {"type": "string"},
      {"type": "object", "required": ["item", "source"], "properties": {"item": {"type": "string"}, "resolution": {"type": ["string", "null"]}, "lease_clause": {"type": ["string", "null"]}, "source": {"type": "string"}}}
    ]}, "description": "String items are unresolved by definition. Object items are resolved (for the conformance matrix's open_items row) only when `resolution` is non-null AND the `lease_clause` phrase appears in the lease."}
  }
}
