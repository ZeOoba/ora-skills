#!/bin/sh
# ora-skills pre-commit (canonical, versioned; core.hooksPath=tools/hooks — set locally per clone).
#
# Check 1 (2026-07-16): any staged change to the repo-root target-markets.json — the canonical
# shared data source injected into 5 skills at package time — must bump its "version" field.
# Motivation: two contradictory v1.5 copies circulated (Notion 'Market' rename-executed vs
# rename-rejected) because the root copy was edited without a version bump.
#
# Check 2 (2026-07-17): every skill dir with staged changes must pass the same frontmatter
# gate package_skills.py runs at packaging time (name == dir name, description present/
# <=1024 chars/tag-free, named-count headers) via package_skills.validate_skill_frontmatter().
# Motivation: psa-reconciliation's description drifted to 1274 chars and reached the repo
# untouched by any gate — package_skills.py only validates at package time, and a raw
# runtime-cache sync skips it entirely. Shared validator (tools/package_skills.py) means
# packaging time and commit time can never disagree about what's valid.
#
# Emergency bypass: git commit --no-verify
if git diff --cached --name-only | grep -qx 'target-markets.json'; then
  if ! git diff --cached -U0 -- target-markets.json | grep '^+' | grep -q '"version"'; then
    echo 'BLOCKED: target-markets.json changed without a "version" bump.' >&2
    echo 'Bump "version" (and "updated") in the file, or --no-verify to override.' >&2
    exit 1
  fi
fi

if ! python tools/package_skills.py --check-staged; then
  echo 'BLOCKED: skill frontmatter validation failed (see errors above).' >&2
  echo 'Fix the SKILL.md frontmatter, or --no-verify to override.' >&2
  exit 1
fi

# Check 3 (2026-07-24): no *.skill or *.plugin build artifact may sit inside a skill's
# own source directory. Motivation: a swapped outdir/skill argument to package_skills.py
# dumped 44 sibling packages into register-scheduled-task/, and one of them recursively
# rebundled the others and ballooned to 15GB before anyone noticed. Both extensions are
# gitignored, so git status alone never surfaces this class of contamination — this
# check runs regardless of what's staged, since the disk damage can predate/outlive any
# one commit. build_plugin.py's *.plugin output shares the identical risk (same
# rglob('*')-based source assembly, same outdir.mkdir(exist_ok=True) collision path).
if ! python tools/package_skills.py --check-tree-hygiene; then
  echo 'BLOCKED: stray .skill/.plugin package(s) found inside a skill source directory (see above).' >&2
  echo 'Move them out of the repo, or --no-verify to override.' >&2
  exit 1
fi

# Check 5 (2026-08-03): detect a runtime cache that is AHEAD of the repo BEFORE Check 4
# overwrites it. Check 4 copies repo -> cache unconditionally, so a skill edited
# platform-side and never committed (a REPO-FIRST violation) is silently clobbered by the
# next commit touching it -- the sync destroys the evidence of the very drift it exists to
# prevent. Four such violations surfaced in the nine days to 2026-08-03 (acquisition-
# underwriting v4.5 and v4.6; disposition-analysis and parcel-data-recovery), every one of
# them caught late and by hand. This runs first, warns loudly, and rescues the
# about-to-be-clobbered cache copy to _staging/repo-first-rescue/. Advisory only -- exits 0
# on every path, including its own errors, so it can never block a commit.
python tools/repo_first_check.py --check-staged

# Check 4 (2026-07-26): sync every staged skill's shipped files into whichever AppData
# runtime-cache mirror(s) already have it installed. Previously a manual "dual-write
# discipline" the README documented but nothing enforced. Additive-only, never blocks
# the commit (a copy hiccup is a mirror-availability problem, not a content-quality one)
# -- see tools/sync_appdata_mirror.py for the full design.
python tools/sync_appdata_mirror.py --check-staged

exit 0
